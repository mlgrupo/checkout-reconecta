# ─────────────────────────────────────────────────────────────
# Checkout Reconecta — variáveis de ambiente
# Copie este arquivo para .env e preencha. Nunca versione o .env.
# ─────────────────────────────────────────────────────────────

# URL base da aplicação (sem barra no final)
APP_BASE_URL=http://localhost:3000

# ── Auth0 · aplicação web (Regular Web Application) ──────────
# Dashboard Auth0 → Applications → sua aplicação → Settings
AUTH0_DOMAIN=seu-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Segredo para criptografar o cookie de sessão. Gere com: openssl rand -hex 32
AUTH0_SECRET=

# ── Auth0 · Management API (Machine to Machine) ──────────────
# Usado pela tela de gestão de usuários. Crie uma aplicação M2M autorizada
# na "Auth0 Management API" com os scopes listados em docs/04-autenticacao-auth0.md
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Conexão de banco de usuários (nome exato em Authentication → Database)
AUTH0_CONNECTION=Username-Password-Authentication
# Namespace do claim de papéis adicionado pela Action (ver docs)
AUTH0_ROLES_CLAIM=https://reconecta.com.br/roles

# ── Asaas ────────────────────────────────────────────────────
# simulacao (sem chave, cobranças fictícias) | sandbox | production
ASAAS_ENV=simulacao
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ── Banco de dados ───────────────────────────────────────────
# Vazio: PGlite local em .data/pglite (só desenvolvimento).
# Produção: URL do PostgreSQL (Railway, Neon, Supabase...).
DATABASE_URL=

# ── Google Tag Manager (opcional; o painel pode sobrescrever) ─
NEXT_PUBLIC_GTM_ID=
